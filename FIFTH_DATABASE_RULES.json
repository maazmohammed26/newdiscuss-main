{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "stories": {
      ".indexOn": ["expiresAt"]
    },
    "storyViews": {
      "$storyId": {
        ".indexOn": [".value"]
      }
    },
    "letterThreads": {
      "$threadId": {
        ".read": "auth != null && (data.child('meta/participantA').val() === auth.uid || data.child('meta/participantB').val() === auth.uid || (!data.exists() && (newData.child('meta/participantA').val() === auth.uid || newData.child('meta/participantB').val() === auth.uid)))",
        "letters": {
          ".indexOn": ["createdAt"]
        }
      }
    },
    "userLetterThreads": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null",
        ".indexOn": ["lastActivityAt", "relationBucket"]
      }
    },
    "letterReceipts": {
      "$threadId": {
        "$letterId": {
          ".read": "auth != null",
          ".write": "auth != null && (data.child('recipientUid').val() === auth.uid || (!data.exists() && newData.child('recipientUid').val() === auth.uid))"
        }
      }
    },
    "letterPreferences": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "letterPolicies": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "letterPendingNonFriend": {
      "$recipientUid": {
        ".read": "auth != null && auth.uid === $recipientUid",
        ".write": "auth != null"
      }
    },
    "letterMutationIds": {
      "$senderUid": {
        ".read": "auth != null && auth.uid === $senderUid",
        ".write": "auth != null && auth.uid === $senderUid"
      }
    },
    "public_memories": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["createdAt", "memoryDate", "ownerId"]
    },
    "user_memories": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "user_day_memory_count": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "shared_received": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "shared_sent": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "memory_shares": {
      "$memoryId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "memory_hearts": {
      "$memoryId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "user_hearts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
